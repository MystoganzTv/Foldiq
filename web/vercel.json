{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/apple-metrics-sync", "schedule": "23 8 * * *" }
  ],
  "headers": [
    {
      "source": "/owner.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; connect-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" }
      ]
    }
  ],
  "redirects": [
    { "source": "/owner", "destination": "/owner.html", "permanent": false },
    { "source": "/contact", "destination": "/contact.html", "permanent": true },
    { "source": "/privacy", "destination": "/privacy-policy.html", "permanent": true },
    { "source": "/terms", "destination": "/terms.html", "permanent": true }
  ]
}
