{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/apple-metrics-sync", "schedule": "23 8 * * *" }
  ],
  "redirects": [
    { "source": "/owner", "destination": "/owner.html", "permanent": false },
    { "source": "/contact", "destination": "/contact.html", "permanent": true },
    { "source": "/privacy", "destination": "/privacy-policy.html", "permanent": true },
    { "source": "/terms", "destination": "/terms.html", "permanent": true }
  ]
}
