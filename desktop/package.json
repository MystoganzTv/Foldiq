{
  "name": "foldiq-desktop",
  "version": "1.0.19",
  "description": "Foldiq — Photo & Video Organizer for Windows",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "prepare:7zip": "node scripts/prepare-7zip.js",
    "prepare:exiftool-win": "node scripts/prepare-exiftool-win.js",
    "prepare:win-runtimes": "npm run prepare:7zip && npm run prepare:exiftool-win",
    "build": "npm run prepare:win-runtimes && vite build && electron-builder",
    "build:win": "npm run prepare:win-runtimes && vite build && electron-builder --win && node scripts/verify-win-package.js",
    "build:store": "npm run prepare:win-runtimes && vite build && electron-builder --win appx --x64 && node scripts/verify-win-package.js",
    "build:mac": "vite build && electron-builder --mac",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "exiftool-vendored": "^37.2.0",
    "heic-decode": "^2.1.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "unzipper": "0.12.5",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tar": "^7.5.2",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "app.foldiq.desktop",
    "productName": "Foldiq",
    "copyright": "© 2026 Foldiq",
    "icon": "assets/icon",
    "directories": {
      "output": "dist-electron",
      "buildResources": "store-resources"
    },
    "asarUnpack": [
      "electron/services/visual-hash.js",
      "electron/services/visual-hash-worker.js",
      "node_modules/heic-decode/**/*",
      "node_modules/jpeg-js/**/*",
      "node_modules/libheif-js/**/*",
      "node_modules/pngjs/**/*",
      "node_modules/pako/**/*",
      "node_modules/utif2/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "extraResources": [
        {
          "from": ".vendor/7zip-win",
          "to": "7zip",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": ".vendor/exiftool-win",
          "to": "exiftool",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.photography",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "appx": {
      "applicationId": "Foldiq",
      "displayName": "Foldiq Photo & Video Organizer",
      "backgroundColor": "transparent",
      "languages": [
        "en-US"
      ],
      "identityName": "Mystodev.FoldiqPhotoVideoOrganizer",
      "publisher": "CN=40266193-F765-424C-8E74-B50758ADB2D2",
      "publisherDisplayName": "Mystodev"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "THIRD_PARTY_NOTICES.txt",
      "!node_modules/7zip-bin/{linux,mac,win,7x.sh}/**/*"
    ]
  }
}
